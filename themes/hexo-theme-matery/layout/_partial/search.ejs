<!-- 搜索遮罩框 -->
<div id="searchModal" class="modal">
    <div class="modal-content">
        <div class="search-header">
            <span class="title"><i class="fas fa-search" aria-hidden="true"></i>&nbsp;&nbsp;<%= __('search') %></span>
            <input type="search" id="searchInput" name="s" placeholder="<%= __('searchTip') %>"
                   aria-label="<%= __('search') %>" class="search-input">
        </div>
        <div id="searchResult"></div>
    </div>
</div>

<script type="text/javascript" src="<%- url_for('/js/search.js') %>"></script>
<script type="text/javascript">
$(function () {
    searchFunc('<%- url_for('/search.xml') %>', 'searchInput', 'searchResult');
});
</script>
